# Kopiraj u .env.local i popuni. Na Vercelu postavi u Settings → Environment Variables.

# SMTP za contact formu (/api/contact)
EMAIL_HOST=smtp.zoho.eu
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Nije obavezno (default: https://kavo.studio)
NEXT_PUBLIC_SITE_URL=https://kavo.studio
